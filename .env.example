# Sydran Maps — environment variables
# Copy this file to .env and fill in your values.

# SQLite database path (relative to project root)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Admin PIN for staff authentication (change this!)
# Used by both the web admin panel and the Fabric mod.
# Minimum 4 characters. Set to something strong.
ADMIN_PIN=change-me-to-a-strong-pin
