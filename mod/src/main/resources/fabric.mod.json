{
  "schemaVersion": 1,
  "id": "sydranmaps",
  "version": "${version}",
  "name": "Sydran Maps",
  "description": "Client-side Minecraft map-art store integration. Upload maps, check for duplicates, view/claim orders, highlight required maps — all from chat commands. No server installation required.",
  "authors": ["Sydran Maps"],
  "contact": {
    "homepage": "https://github.com/doodlyyousuf/SydranMaps",
    "sources": "https://github.com/doodlyyousuf/SydranMaps"
  },
  "license": "MIT",
  "icon": "assets/sydranmaps/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.sydran.maps.client.SydranClientMod"]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
}
